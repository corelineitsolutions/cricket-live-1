NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/cricket_live

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Latiyal Infotech cricket API. Requests go to ${LATIYAL_API_URL}/<endpoint>/${LATIYAL_API_TOKEN}
# ({{api_url}}{{api_plan}} in the Postman collection is LATIYAL_API_URL).
LATIYAL_API_URL=https://api.latiyalinfotech.com/apiv5
LATIYAL_API_TOKEN=

# Polling interval with no live matches, with live matches, and in a close finish.
# Each live poll makes 1 liveMatch call per live match (Latiyal suggests ~700 ms).
LATIYAL_IDLE_INTERVAL_MS=60000
LATIYAL_LIVE_INTERVAL_MS=1000
LATIYAL_ACTIVE_INTERVAL_MS=700
# How long the worker reuses one liveMatchList response (0 = fetch it every poll).
LATIYAL_LIST_INTERVAL_MS=15000
# The Latiyal plan has no call limit: 0 = unlimited (calls are still counted on the
# dashboard). A positive number turns it into an hourly cap shared through Redis.
LATIYAL_MAX_CALLS_PER_HOUR=0
LATIYAL_TIMEOUT_MS=8000
LATIYAL_MAX_RETRIES=1
# Optional hourly cap for app-driven requests (/feeds, scorecard, commentary). 0 = unlimited.
# These are cached, so each endpoint + params reaches Latiyal once per refresh period.
LATIYAL_ON_DEMAND_MAX_CALLS_PER_HOUR=0

# Public REST limits per client IP, shared by all API instances through Redis.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST_PER_SECOND=20

# Run the live-score worker inside this process. Set to false on API processes
# when the worker runs as its own process (dist/worker.js).
LIVE_SCORE_WORKER_ENABLED=true

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Random string, at least 32 characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Comma-separated browser origins, or * for any origin.
# Native mobile clients do not use CORS. The admin panel does: in production set
# CORS_ORIGIN=https://admin.example.com (plus any other browser origin you need).
CORS_ORIGIN=*

# Bearer token for the Prometheus endpoint GET /metrics. Empty disables it.
# At least 32 characters in production (e.g. `openssl rand -hex 32`).
METRICS_TOKEN=

# Serve Swagger UI at /api/docs. Keep it on for the mobile developer, or restrict it in Nginx.
SWAGGER_ENABLED=true

# Cricket AI assistant (POST /api/v1/ai/ask). Off by default.
# For team Hinglish training on the server: AI_ENABLED=true, LLM_PROVIDER=mock (no Groq),
# AI_LOG_QUESTIONS=true, raise AI_REQUESTS_PER_DEVICE_PER_DAY, then migrate + restart.
AI_ENABLED=false
# mock = template answers over live/history tools, no model and no cost (use this while training routing).
# openai-compatible = any /chat/completions server (Ollama, vLLM, LM Studio, a hosted provider).
# Real LLM examples (then restart/reload the API):
#   Ollama: LLM_PROVIDER=openai-compatible, LLM_BASE_URL=http://127.0.0.1:11434/v1,
#           LLM_MODEL=qwen2.5:7b-instruct, AI_DAILY_TOKEN_BUDGET=200000
#   Groq:   LLM_PROVIDER=openai-compatible, LLM_BASE_URL=https://api.groq.com/openai/v1,
#           LLM_API_KEY=gsk_..., LLM_MODEL=openai/gpt-oss-20b (exact id; no "LLM_MODEL=" prefix)
# Smoke: mocked:false; WC 2019 winner; most runs/wickets in WC; next-6-overs estimate.
LLM_PROVIDER=mock
# https, or http only for localhost (e.g. http://127.0.0.1:11434/v1 for Ollama). No credentials or query.
LLM_BASE_URL=
# Not needed for a localhost server. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=600
# Prices for the cost estimate on the admin AI page (currency of your choice). 0 = unknown, not "free".
LLM_COST_PER_1K_INPUT_TOKENS=0
LLM_COST_PER_1K_OUTPUT_TOKENS=0
# Tokens per UTC day across all instances. A real provider is refused while this is 0.
AI_DAILY_TOKEN_BUDGET=0
# Concurrent questions per API instance.
AI_MAX_CONCURRENT=4
AI_REQUESTS_PER_DEVICE_PER_MINUTE=5
AI_REQUESTS_PER_DEVICE_PER_DAY=50
AI_REQUESTS_PER_IP_PER_MINUTE=20
# Whole question incl. tool rounds. Keep it below nginx proxy_read_timeout (30 s by default).
AI_REQUEST_TIMEOUT_MS=25000
# Let the AI answer from the Cricsheet history (player records, head-to-head, venues).
# Turn on only after the hist_* migration is applied and the archive is imported.
AI_HISTORY_ENABLED=false
# Store Ask question text in ai_training_questions for admin review (team training). Off = privacy default.
AI_LOG_QUESTIONS=false
# Local Qwen (llama.cpp) intent classifier — understands Hinglish; tools still supply facts.
# Keep LLM_PROVIDER=mock. Do not expose AI_LOCAL_MODEL_URL beyond 127.0.0.1.
# AI_INTENT_CLASSIFIER=local
# AI_LOCAL_MODEL_URL=http://127.0.0.1:8081
# AI_LOCAL_MODEL_NAME=qwen3-1.7b
# AI_LOCAL_MODEL_TIMEOUT_MS=5000
# AI_INTENT_MIN_CONFIDENCE=0.45
# AI_INTENT_MAX_OUTPUT_TOKENS=120
# AI_INTENT_MAX_CONCURRENT=2
AI_INTENT_CLASSIFIER=off
AI_LOCAL_MODEL_URL=
AI_LOCAL_MODEL_NAME=
AI_LOCAL_MODEL_TIMEOUT_MS=5000
AI_INTENT_MIN_CONFIDENCE=0.45
AI_INTENT_MAX_OUTPUT_TOKENS=120
AI_INTENT_MAX_CONCURRENT=2

# Cloudflare R2 for admin ad image uploads (bucket name "ads"). Leave empty to use Image URL only.
# Create an R2 API token with Object Read & Write on the ads bucket, and a public access URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ADS=ads
# e.g. https://pub-xxxxx.r2.dev or https://ads.yourdomain.com (no trailing slash)
R2_PUBLIC_BASE_URL=

# Razorpay Pro (₹999 / 6 months, ₹1799 / 1 year). Key id is returned to the app for Checkout.
# Create two Plans in the Razorpay dashboard and paste their plan_… ids below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_6M_ID=
RAZORPAY_PLAN_1Y_ID=

# Cricsheet history import (npm run history:import) and AI history tools. Optional separate
# MySQL for hist_* tables. When set, the API reads archive stats from this URL; when empty,
# it uses DATABASE_URL. The importer refuses remote hosts/production without --allow-* flags.
HISTORY_DATABASE_URL=
# Local MySQL test database (name must end in _test) for the importer integration tests.
HISTORY_TEST_DATABASE_URL=
